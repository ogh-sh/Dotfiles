# User Git configuration file
[user]
name = Octavian Ghiuritan
email = octa@ogh.sh
[init]
defaultBranch = master
[commit]
template = $HOME/Dotfiles/config/git/gitmessage
[core]
excludesfile = ~/.gitignore_global
editor = code
whitespace = error
[filter "lfs"]
process = git-lfs filter-process
required = true
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
[url "git@github.com:"]
insteadOf = "gh"
